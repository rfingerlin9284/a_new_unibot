# Critical Files Snapshot System - Exclusions

# Snapshot files and backups
live_snapshot_*
backups/
*.zip

# Log files
*.log
critical_files_snapshot.log

# Temporary files
/tmp/
*.tmp
*.temp

# Environment and sensitive files
.env
config/api_keys.json

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Reports (keep only latest)
critical_files_report_*.md
!critical_files_report_latest.md
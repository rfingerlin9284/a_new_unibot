# RICK Environment Configuration Template
# Copy to .env and customize

# Trading mode
MODE=ghost

# Data source root directory
DATA_ROOT=thefolder

# WebSocket URL for live signals (optional)
WS_URL=ws://localhost:5056

# Status page URL (optional)
STATUS_HTTP_URL=http://localhost:8080/status.html

# Dashboard server port
STREAMLIT_PORT=8501

# Dual-model AI configuration (optional)
OPENAI_MODEL_ALPHA=gpt-code-alpha
OPENAI_MODEL_BETA=gpt-copy-beta
